# 网页默认监听宿主机所有网卡；其他依赖服务不映射宿主机端口。
WEB_PORT=8088
# 允许写请求的完整来源，逗号分隔且不加空格；开发联调需加入 http://127.0.0.1:5173。
APP_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
# 通过 HTTPS 使用时设为 true。
COOKIE_SECURE=false
# 数据库管理密码与运行账号密码必须独立；运行密码至少 20 位。
POSTGRES_PASSWORD=replace-with-random-database-password
APP_DB_PASSWORD=replace-with-a-separate-random-runtime-password
ADMIN_USERNAME=admin
# 至少 12 位；仅在空用户库首次启动时创建管理员，不重置已有密码。
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
DIFY_LOCAL_BASE_URL=http://host.docker.internal:8880/v1
DIFY_LOCAL_TOPIC_KEY=
DIFY_LOCAL_RECORD_KEY=
DIFY_EXTERNAL_BASE_URL=https://api.dify.ai/v1
DIFY_EXTERNAL_TOPIC_KEY=
DIFY_EXTERNAL_RECORD_KEY=
LOCAL_OLLAMA_MODELS_DIR=E:/Ollama/models
LOCAL_DIFY_NETWORK=dify-local_default
AI_CONTEXT_TOKENS=8192

# 两组模型预算，必须与对应 Dify 应用中实际选择的模型和上下文一致。
AI_LOCAL_MODEL=qwen3-vl:4b-instruct-q4_K_M
AI_LOCAL_TOKENIZER_KIND=hf_json
AI_LOCAL_TOKENIZER_FILE=/srv/tokenizers/qwen3-vl.json
AI_LOCAL_CONTEXT_TOKENS=8192
AI_LOCAL_TOPIC_OUTPUT_TOKENS=1800
AI_LOCAL_RECORD_OUTPUT_TOKENS=2600
AI_EXTERNAL_MODEL=operator_configured
AI_EXTERNAL_TOKENIZER_KIND=utf8_upper_bound
AI_EXTERNAL_CONTEXT_TOKENS=8192
AI_EXTERNAL_TOPIC_OUTPUT_TOKENS=1800
AI_EXTERNAL_RECORD_OUTPUT_TOKENS=2600
